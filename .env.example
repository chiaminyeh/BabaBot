# Required Discord bot token. Create this in the Discord Developer Portal.
DISCORD_TOKEN=

# Optional: enables Gemini fallback responses in response_cog.py.
# GEMINI_API_KEY=replace_with_gemini_key

# Optional: your Discord user ID for owner-only commands.
# BABABOT_OWNER_ID=123456789012345678

# Optional: channel used for monitor notifications.
# BABABOT_MONITOR_CHANNEL_ID=123456789012345678
# DISCORD_HOME_CHANNEL=123456789012345678

# Optional: defaults to ~/Music. Use an absolute path if you prefer another folder.
# BABABOT_MUSIC_FOLDER=

# Optional: defaults to ffmpeg resolved from PATH. Set a full path when needed.
# BABABOT_FFMPEG_EXECUTABLE=ffmpeg
